# ==========================================================================
# Copia este archivo a `.env.local` y rellena los valores reales.
# `.env.local` está en .gitignore — NUNCA commitees secretos.
# ==========================================================================

# --- Base de datos -------------------------------------------------------
# `sslmode=require` obligatorio en cualquier entorno que no sea localhost.
DATABASE_URL="postgresql://dental:dental@localhost:5432/dental_coworking?schema=public"

# --- Autenticación (NextAuth v5) -----------------------------------------
# Genera con: openssl rand -base64 32
AUTH_SECRET="cambia-esto-por-un-secreto-de-32-bytes-en-base64"

# Origen público de la app. Se usa para validar Origin/Referer (anti-CSRF)
# y para construir callbacks de OAuth.
APP_ORIGIN="http://localhost:3000"

# --- Automatización (n8n / bot de WhatsApp) ------------------------------
# Secreto compartido con el que n8n firma cada request (HMAC-SHA256).
# Genera con: openssl rand -hex 32
AUTOMATION_HMAC_SECRET="cambia-esto-por-32-bytes-en-hex"

# Ventana de tolerancia (segundos) para el timestamp de la firma.
# Valores altos amplían la ventana de replay; 300s es un buen equilibrio.
AUTOMATION_SIGNATURE_TOLERANCE_SECONDS="300"

# --- Salida hacia WhatsApp -----------------------------------------------
# Webhook de n8n al que el panel envía los mensajes que escribe un agente.
# n8n es quien tiene las credenciales de WhatsApp; duplicar esa integración
# aquí significaría mantener dos caminos de salida.
# Se firma con el MISMO AUTOMATION_HMAC_SECRET de los endpoints entrantes.
#
# Si se deja vacío: los mensajes se guardan en el historial pero NO se
# entregan, y la interfaz lo avisa. Nunca se finge que se enviaron.
WHATSAPP_OUTBOUND_WEBHOOK_URL=""
# Webhook de n8n al que el panel AVISA cuando alguien enciende o apaga la IA
# de un chat desde el monitor. Es sólo un aviso: la fuente de verdad sigue
# siendo `POST /api/automation/conversation`, que el bot consulta en cada
# mensaje. Dejarlo vacío no rompe nada, sólo quita la reacción inmediata.
WHATSAPP_EVENTS_WEBHOOK_URL=""


# --- Modo de datos -------------------------------------------------------
# "mock" → repositorios en memoria (UI funcional sin Postgres)
# "db"   → Prisma contra PostgreSQL real
DATA_SOURCE="mock"

# --- Reglas de negocio ---------------------------------------------------
# Porcentaje que retiene la clínica. El odontólogo recibe (100 - este valor).
# Es el DEFAULT: cada odontólogo puede tener su propio porcentaje en la DB.
DEFAULT_CLINIC_COMMISSION_PERCENT="40"

# Zona horaria canónica de la clínica. Toda la agenda se calcula aquí.
CLINIC_TIMEZONE="America/Bogota"

# --- Red -----------------------------------------------------------------
# Cuántos proxies inversos de CONFIANZA hay entre internet y este proceso.
# Decide qué parte de X-Forwarded-For es creíble para el rate limit.
#   0 → sin proxy (desarrollo local): la cabecera se ignora entera
#   1 → detrás de EasyPanel / Traefik / nginx
#   2 → Cloudflare por delante de ese proxy
# Puesto de menos, el limitador de login se salta con una cabecera falsa.
TRUSTED_PROXY_HOPS="0"
